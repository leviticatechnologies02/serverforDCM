# Mongo
MONGO_URI=mongodb://localhost:27017/yourdb

# Razorpay (website flow unchanged)
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Play service account: either set the JSON string or the file path
# Option A: paste the entire JSON credentials as a single-line JSON string
GOOGLE_SERVICE_ACCOUNT_JSON={...}
# Option B: path to json key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/google-service-account.json

# Frontend URLs
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

NODE_ENV=development
PORT=7777
# Copy this file to .env and fill in your own values

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/dcm

# JWT secrets
ACCESS_SECRET=your_access_token_secret
REFRESH_SECRET=your_refresh_token_secret

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP configuration for sending email (cPanel or any provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password

# Frontend URLs used for CORS and email links
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Optional values
PORT=7777
NODE_ENV=development

# Razorpay keys (used in payment controllers)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Other optional env vars
# ...
